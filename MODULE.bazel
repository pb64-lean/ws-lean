module(
    name = "ws-lean",
    version = "0.1.0",
    compatibility_level = 1,
)

# Base Lean build rules.
bazel_dep(name = "rules_lean", version = "0.1.0")
archive_override(
    module_name = "rules_lean",
    integrity = "sha256-tPQDP5DWBNcwtCbZVLPkNqeFjKjWzJulx05ScxooN6M=",
    strip_prefix = "rules_lean-ac0ad9a76428a9aa05f885a53bab6eb302682649",
    urls = [
        "https://github.com/pb64-lean/rules_lean/archive/ac0ad9a76428a9aa05f885a53bab6eb302682649.tar.gz",
    ],
)

# HTTP/2, TLS sessions, DNS, and trust-store support.
bazel_dep(name = "http2-lean", version = "0.1.0", repo_name = "http2_lean")
archive_override(
    module_name = "http2-lean",
    integrity = "sha256-rVteydmJ4HoqzdoL+9VEJMXCfJ07r++od1ftyBsnypI=",
    strip_prefix = "http2-lean-0.1.0",
    urls = [
        "https://github.com/pb64-lean/http2-lean/archive/refs/tags/v0.1.0.tar.gz",
    ],
)

# Root overrides are not inherited from dependencies, so the runtime's TLS
# dependency is resolved here as well.
bazel_dep(name = "tls13-lean", version = "0.1.0", repo_name = "tls13_lean")
archive_override(
    module_name = "tls13-lean",
    integrity = "sha256-wInyKUe/AxXRSO2YaKwpqgbBU/ek9UG+eYPAeGvpe6c=",
    strip_prefix = "tls13-lean-4fa14fe068d9ea17c85294a6a27c224b2de5cddb",
    urls = [
        "https://github.com/pb64-lean/tls13-lean/archive/4fa14fe068d9ea17c85294a6a27c224b2de5cddb.tar.gz",
    ],
)

# Raw DEFLATE for RFC 7692.
bazel_dep(name = "zlib", version = "1.3.1.bcr.5")
bazel_dep(name = "rules_cc", version = "0.2.17")

lean = use_extension("@rules_lean//lean:extensions.bzl", "lean", dev_dependency = True)
lean.nix_toolchain(
    name = "lean4",
    attr = "lean4_upstream_std",
    nix_file = "@rules_lean//:nixpkgs.nix",
    nix_file_deps = ["@rules_lean//:nixpkgs.json"],
)
use_repo(lean, "lean4_toolchain")
register_toolchains("@lean4_toolchain//:all", dev_dependency = True)
